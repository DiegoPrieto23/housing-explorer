# Copy to .env at the repo root. Read by both the backend and docker compose.

DEBUG=false

# SQLite database file
DATABASE_PATH=./data/housing.db

# Local datasets directory
DATA_DIR=./data

# Official Idealista API credentials (for the future IdealistaApiSource).
# Request access at https://developers.idealista.com/access-request
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
